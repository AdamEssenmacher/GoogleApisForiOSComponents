<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDefaultItems>false</EnableDefaultItems>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Xamarin.Build.Download" Version="[0.11.6]" />
    <XamarinBuildDownload Include="FirebaseiOSSDK-13.1.1">
      <Url>https://github.com/firebase/firebase-ios-sdk/releases/download/13.1.1/Firebase.zip</Url>
      <Kind>Zip</Kind>
      <Sha256>eab04111b6b6ebd2bbd9264b452b2eec5be13703207f32f7cf10d9040e246b70</Sha256>
      <ExclusiveLockTimeout>1800</ExclusiveLockTimeout>
    </XamarinBuildDownload>
  </ItemGroup>
  <Target Name="Acquire" DependsOnTargets="_XamarinBuildDownload" />
</Project>

<Project>
  <Import Project="$(MSBuildThisFileDirectory)Firebase.Native.Common.targets" />
  <Target Name="_FirebaseNative_AdamE_Google_iOS_GoogleUtilities" BeforeTargets="_BeforeCoreCompileInterfaceDefinitions" DependsOnTargets="_XamarinBuildDownload" Condition="'$(IsBindingProject)' != 'true' And '$(DesignTimeBuild)' != 'true' And '$(IsCrossTargetingBuild)' != 'true' And ('$(TargetPlatformIdentifier)' == 'ios' Or '$(TargetPlatformIdentifier)' == 'maccatalyst') And ('$(OutputType)' != 'Library' Or '$(IsAppExtension)' == 'True')">
    <Error Condition="!Exists('$(_FirebaseNativeRoot)Firebase/FirebaseAnalytics/GoogleUtilities.xcframework')" Text="Missing Firebase native asset google-utilities. $(_FirebaseNativeCleanup)" />
    <Error Condition="'$(TargetPlatformIdentifier)' == 'ios' And !$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('iossimulator-')) And !Exists('$(_FirebaseNativeRoot)Firebase/FirebaseAnalytics/GoogleUtilities.xcframework/ios-arm64/GoogleUtilities.framework/GoogleUtilities_Privacy.bundle')" Text="Missing Firebase native asset google-utilities-GoogleUtilities_Privacy.bundle-device. $(_FirebaseNativeCleanup)" />
    <Error Condition="'$(TargetPlatformIdentifier)' == 'ios' And $([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('iossimulator-')) And !Exists('$(_FirebaseNativeRoot)Firebase/FirebaseAnalytics/GoogleUtilities.xcframework/ios-arm64_x86_64-simulator/GoogleUtilities.framework/GoogleUtilities_Privacy.bundle')" Text="Missing Firebase native asset google-utilities-GoogleUtilities_Privacy.bundle-simulator. $(_FirebaseNativeCleanup)" />
    <Error Condition="'$(TargetPlatformIdentifier)' == 'maccatalyst' And !Exists('$(_FirebaseNativeRoot)Firebase/FirebaseAnalytics/GoogleUtilities.xcframework/ios-arm64_x86_64-maccatalyst/GoogleUtilities.framework/Versions/A/Resources/GoogleUtilities_Privacy.bundle')" Text="Missing Firebase native asset google-utilities-GoogleUtilities_Privacy.bundle-catalyst. $(_FirebaseNativeCleanup)" />
    <ItemGroup>
      <NativeReference Include="$(_FirebaseNativeRoot)Firebase/FirebaseAnalytics/GoogleUtilities.xcframework">
        <Kind>Framework</Kind>
        <SmartLink>True</SmartLink>
        <ForceLoad>True</ForceLoad>
        <IsCxx>True</IsCxx>
        <LinkWithSwiftSystemLibraries>true</LinkWithSwiftSystemLibraries>
        <LinkerFlags>-ObjC -lc++</LinkerFlags>
        <Frameworks>Security SystemConfiguration</Frameworks>
      </NativeReference>
      <_FirebaseBundle_google_utilities_GoogleUtilities_Privacy_bundle_device Include="$(_FirebaseNativeRoot)Firebase/FirebaseAnalytics/GoogleUtilities.xcframework/ios-arm64/GoogleUtilities.framework/GoogleUtilities_Privacy.bundle/**/*" Condition="'$(TargetPlatformIdentifier)' == 'ios' And !$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('iossimulator-'))" />
      <_FirebaseBundle_google_utilities_GoogleUtilities_Privacy_bundle_simulator Include="$(_FirebaseNativeRoot)Firebase/FirebaseAnalytics/GoogleUtilities.xcframework/ios-arm64_x86_64-simulator/GoogleUtilities.framework/GoogleUtilities_Privacy.bundle/**/*" Condition="'$(TargetPlatformIdentifier)' == 'ios' And $([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('iossimulator-'))" />
      <_FirebaseBundle_google_utilities_GoogleUtilities_Privacy_bundle_catalyst Include="$(_FirebaseNativeRoot)Firebase/FirebaseAnalytics/GoogleUtilities.xcframework/ios-arm64_x86_64-maccatalyst/GoogleUtilities.framework/Versions/A/Resources/GoogleUtilities_Privacy.bundle/**/*" Condition="'$(TargetPlatformIdentifier)' == 'maccatalyst'" />
    </ItemGroup>
    <ItemGroup>
      <BundleResource Include="@(_FirebaseBundle_google_utilities_GoogleUtilities_Privacy_bundle_device)">
        <LogicalName>GoogleUtilities_Privacy.bundle/%(_FirebaseBundle_google_utilities_GoogleUtilities_Privacy_bundle_device.RecursiveDir)%(_FirebaseBundle_google_utilities_GoogleUtilities_Privacy_bundle_device.Filename)%(_FirebaseBundle_google_utilities_GoogleUtilities_Privacy_bundle_device.Extension)</LogicalName>
      </BundleResource>
    </ItemGroup>
    <ItemGroup>
      <BundleResource Include="@(_FirebaseBundle_google_utilities_GoogleUtilities_Privacy_bundle_simulator)">
        <LogicalName>GoogleUtilities_Privacy.bundle/%(_FirebaseBundle_google_utilities_GoogleUtilities_Privacy_bundle_simulator.RecursiveDir)%(_FirebaseBundle_google_utilities_GoogleUtilities_Privacy_bundle_simulator.Filename)%(_FirebaseBundle_google_utilities_GoogleUtilities_Privacy_bundle_simulator.Extension)</LogicalName>
      </BundleResource>
    </ItemGroup>
    <ItemGroup>
      <BundleResource Include="@(_FirebaseBundle_google_utilities_GoogleUtilities_Privacy_bundle_catalyst)">
        <LogicalName>GoogleUtilities_Privacy.bundle/%(_FirebaseBundle_google_utilities_GoogleUtilities_Privacy_bundle_catalyst.RecursiveDir)%(_FirebaseBundle_google_utilities_GoogleUtilities_Privacy_bundle_catalyst.Filename)%(_FirebaseBundle_google_utilities_GoogleUtilities_Privacy_bundle_catalyst.Extension)</LogicalName>
      </BundleResource>
    </ItemGroup>
  </Target>
</Project>

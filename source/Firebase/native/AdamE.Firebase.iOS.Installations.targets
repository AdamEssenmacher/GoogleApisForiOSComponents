<Project>
  <Import Project="$(MSBuildThisFileDirectory)Firebase.Native.Common.targets" />
  <Target Name="_FirebaseNative_AdamE_Firebase_iOS_Installations" BeforeTargets="_BeforeCoreCompileInterfaceDefinitions" DependsOnTargets="_XamarinBuildDownload" Condition="'$(IsBindingProject)' != 'true' And '$(DesignTimeBuild)' != 'true' And '$(IsCrossTargetingBuild)' != 'true' And ('$(TargetPlatformIdentifier)' == 'ios' Or '$(TargetPlatformIdentifier)' == 'maccatalyst') And ('$(OutputType)' != 'Library' Or '$(IsAppExtension)' == 'True')">
    <Error Condition="!Exists('$(_FirebaseNativeRoot)Firebase/FirebaseAnalytics/FirebaseInstallations.xcframework')" Text="Missing Firebase native asset firebase-installations. $(_FirebaseNativeCleanup)" />
    <Error Condition="'$(TargetPlatformIdentifier)' == 'ios' And !$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('iossimulator-')) And !Exists('$(_FirebaseNativeRoot)Firebase/FirebaseAnalytics/FirebaseInstallations.xcframework/ios-arm64/FirebaseInstallations.framework/FirebaseInstallations_Privacy.bundle')" Text="Missing Firebase native asset firebase-installations-FirebaseInstallations_Privacy.bundle-device. $(_FirebaseNativeCleanup)" />
    <Error Condition="'$(TargetPlatformIdentifier)' == 'ios' And $([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('iossimulator-')) And !Exists('$(_FirebaseNativeRoot)Firebase/FirebaseAnalytics/FirebaseInstallations.xcframework/ios-arm64_x86_64-simulator/FirebaseInstallations.framework/FirebaseInstallations_Privacy.bundle')" Text="Missing Firebase native asset firebase-installations-FirebaseInstallations_Privacy.bundle-simulator. $(_FirebaseNativeCleanup)" />
    <Error Condition="'$(TargetPlatformIdentifier)' == 'maccatalyst' And !Exists('$(_FirebaseNativeRoot)Firebase/FirebaseAnalytics/FirebaseInstallations.xcframework/ios-arm64_x86_64-maccatalyst/FirebaseInstallations.framework/Versions/A/Resources/FirebaseInstallations_Privacy.bundle')" Text="Missing Firebase native asset firebase-installations-FirebaseInstallations_Privacy.bundle-catalyst. $(_FirebaseNativeCleanup)" />
    <Error Condition="!Exists('$(_FirebaseNativeRoot)Firebase/FirebaseCrashlytics/FirebaseSessions.xcframework')" Text="Missing Firebase native asset firebase-sessions. $(_FirebaseNativeCleanup)" />
    <ItemGroup>
      <NativeReference Include="$(_FirebaseNativeRoot)Firebase/FirebaseAnalytics/FirebaseInstallations.xcframework">
        <LinkerFlags>-ObjC -lc++</LinkerFlags>
        <Frameworks>Security</Frameworks>
        <Kind>Framework</Kind>
        <SmartLink>True</SmartLink>
        <ForceLoad>True</ForceLoad>
        <LinkWithSwiftSystemLibraries>true</LinkWithSwiftSystemLibraries>
      </NativeReference>
      <_FirebaseBundle_firebase_installations_FirebaseInstallations_Privacy_bundle_device Include="$(_FirebaseNativeRoot)Firebase/FirebaseAnalytics/FirebaseInstallations.xcframework/ios-arm64/FirebaseInstallations.framework/FirebaseInstallations_Privacy.bundle/**/*" Condition="'$(TargetPlatformIdentifier)' == 'ios' And !$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('iossimulator-'))" />
      <_FirebaseBundle_firebase_installations_FirebaseInstallations_Privacy_bundle_simulator Include="$(_FirebaseNativeRoot)Firebase/FirebaseAnalytics/FirebaseInstallations.xcframework/ios-arm64_x86_64-simulator/FirebaseInstallations.framework/FirebaseInstallations_Privacy.bundle/**/*" Condition="'$(TargetPlatformIdentifier)' == 'ios' And $([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('iossimulator-'))" />
      <_FirebaseBundle_firebase_installations_FirebaseInstallations_Privacy_bundle_catalyst Include="$(_FirebaseNativeRoot)Firebase/FirebaseAnalytics/FirebaseInstallations.xcframework/ios-arm64_x86_64-maccatalyst/FirebaseInstallations.framework/Versions/A/Resources/FirebaseInstallations_Privacy.bundle/**/*" Condition="'$(TargetPlatformIdentifier)' == 'maccatalyst'" />
      <NativeReference Include="$(_FirebaseNativeRoot)Firebase/FirebaseCrashlytics/FirebaseSessions.xcframework">
        <LinkerFlags>-ObjC -lc++</LinkerFlags>
        <Kind>Framework</Kind>
        <SmartLink>True</SmartLink>
        <ForceLoad>True</ForceLoad>
        <LinkWithSwiftSystemLibraries>true</LinkWithSwiftSystemLibraries>
      </NativeReference>
    </ItemGroup>
    <ItemGroup>
      <BundleResource Include="@(_FirebaseBundle_firebase_installations_FirebaseInstallations_Privacy_bundle_device)">
        <LogicalName>FirebaseInstallations_Privacy.bundle/%(_FirebaseBundle_firebase_installations_FirebaseInstallations_Privacy_bundle_device.RecursiveDir)%(_FirebaseBundle_firebase_installations_FirebaseInstallations_Privacy_bundle_device.Filename)%(_FirebaseBundle_firebase_installations_FirebaseInstallations_Privacy_bundle_device.Extension)</LogicalName>
      </BundleResource>
    </ItemGroup>
    <ItemGroup>
      <BundleResource Include="@(_FirebaseBundle_firebase_installations_FirebaseInstallations_Privacy_bundle_simulator)">
        <LogicalName>FirebaseInstallations_Privacy.bundle/%(_FirebaseBundle_firebase_installations_FirebaseInstallations_Privacy_bundle_simulator.RecursiveDir)%(_FirebaseBundle_firebase_installations_FirebaseInstallations_Privacy_bundle_simulator.Filename)%(_FirebaseBundle_firebase_installations_FirebaseInstallations_Privacy_bundle_simulator.Extension)</LogicalName>
      </BundleResource>
    </ItemGroup>
    <ItemGroup>
      <BundleResource Include="@(_FirebaseBundle_firebase_installations_FirebaseInstallations_Privacy_bundle_catalyst)">
        <LogicalName>FirebaseInstallations_Privacy.bundle/%(_FirebaseBundle_firebase_installations_FirebaseInstallations_Privacy_bundle_catalyst.RecursiveDir)%(_FirebaseBundle_firebase_installations_FirebaseInstallations_Privacy_bundle_catalyst.Filename)%(_FirebaseBundle_firebase_installations_FirebaseInstallations_Privacy_bundle_catalyst.Extension)</LogicalName>
      </BundleResource>
    </ItemGroup>
  </Target>
</Project>

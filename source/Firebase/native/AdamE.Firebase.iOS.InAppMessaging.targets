<Project>
  <Import Project="$(MSBuildThisFileDirectory)Firebase.Native.Common.targets" />
  <Target Name="_FirebaseNative_AdamE_Firebase_iOS_InAppMessaging" BeforeTargets="_BeforeCoreCompileInterfaceDefinitions" DependsOnTargets="_XamarinBuildDownload" Condition="'$(IsBindingProject)' != 'true' And '$(DesignTimeBuild)' != 'true' And '$(IsCrossTargetingBuild)' != 'true' And ('$(TargetPlatformIdentifier)' == 'ios' Or '$(TargetPlatformIdentifier)' == 'maccatalyst') And ('$(OutputType)' != 'Library' Or '$(IsAppExtension)' == 'True')">
    <Error Condition="!Exists('$(_FirebaseNativeRoot)Firebase/FirebaseInAppMessaging/FirebaseInAppMessaging.xcframework')" Text="Missing Firebase native asset firebase-in-app-messaging. $(_FirebaseNativeCleanup)" />
    <Error Condition="'$(TargetPlatformIdentifier)' == 'ios' And !$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('iossimulator-')) And !Exists('$(_FirebaseNativeRoot)Firebase/FirebaseInAppMessaging/FirebaseInAppMessaging.xcframework/ios-arm64/FirebaseInAppMessaging.framework/InAppMessagingDisplayResources.bundle')" Text="Missing Firebase native asset firebase-in-app-messaging-InAppMessagingDisplayResources.bundle-device. $(_FirebaseNativeCleanup)" />
    <Error Condition="'$(TargetPlatformIdentifier)' == 'ios' And $([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('iossimulator-')) And !Exists('$(_FirebaseNativeRoot)Firebase/FirebaseInAppMessaging/FirebaseInAppMessaging.xcframework/ios-arm64_x86_64-simulator/FirebaseInAppMessaging.framework/InAppMessagingDisplayResources.bundle')" Text="Missing Firebase native asset firebase-in-app-messaging-InAppMessagingDisplayResources.bundle-simulator. $(_FirebaseNativeCleanup)" />
    <Error Condition="'$(TargetPlatformIdentifier)' == 'maccatalyst' And !Exists('$(_FirebaseNativeRoot)Firebase/FirebaseInAppMessaging/FirebaseInAppMessaging.xcframework/ios-arm64_x86_64-maccatalyst/FirebaseInAppMessaging.framework/Versions/A/Resources/InAppMessagingDisplayResources.bundle')" Text="Missing Firebase native asset firebase-in-app-messaging-InAppMessagingDisplayResources.bundle-catalyst. $(_FirebaseNativeCleanup)" />
    <ItemGroup>
      <NativeReference Include="$(_FirebaseNativeRoot)Firebase/FirebaseInAppMessaging/FirebaseInAppMessaging.xcframework">
        <LinkerFlags>-ObjC -lc++</LinkerFlags>
        <Frameworks>CoreTelephony QuartzCore SystemConfiguration UIKit</Frameworks>
        <Kind>Framework</Kind>
        <SmartLink>True</SmartLink>
        <ForceLoad>True</ForceLoad>
        <LinkWithSwiftSystemLibraries>true</LinkWithSwiftSystemLibraries>
      </NativeReference>
      <_FirebaseBundle_firebase_in_app_messaging_InAppMessagingDisplayResources_bundle_device Include="$(_FirebaseNativeRoot)Firebase/FirebaseInAppMessaging/FirebaseInAppMessaging.xcframework/ios-arm64/FirebaseInAppMessaging.framework/InAppMessagingDisplayResources.bundle/**/*" Condition="'$(TargetPlatformIdentifier)' == 'ios' And !$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('iossimulator-'))" />
      <_FirebaseBundle_firebase_in_app_messaging_InAppMessagingDisplayResources_bundle_simulator Include="$(_FirebaseNativeRoot)Firebase/FirebaseInAppMessaging/FirebaseInAppMessaging.xcframework/ios-arm64_x86_64-simulator/FirebaseInAppMessaging.framework/InAppMessagingDisplayResources.bundle/**/*" Condition="'$(TargetPlatformIdentifier)' == 'ios' And $([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('iossimulator-'))" />
      <_FirebaseBundle_firebase_in_app_messaging_InAppMessagingDisplayResources_bundle_catalyst Include="$(_FirebaseNativeRoot)Firebase/FirebaseInAppMessaging/FirebaseInAppMessaging.xcframework/ios-arm64_x86_64-maccatalyst/FirebaseInAppMessaging.framework/Versions/A/Resources/InAppMessagingDisplayResources.bundle/**/*" Condition="'$(TargetPlatformIdentifier)' == 'maccatalyst'" />
    </ItemGroup>
    <ItemGroup>
      <BundleResource Include="@(_FirebaseBundle_firebase_in_app_messaging_InAppMessagingDisplayResources_bundle_device)">
        <LogicalName>InAppMessagingDisplayResources.bundle/%(_FirebaseBundle_firebase_in_app_messaging_InAppMessagingDisplayResources_bundle_device.RecursiveDir)%(_FirebaseBundle_firebase_in_app_messaging_InAppMessagingDisplayResources_bundle_device.Filename)%(_FirebaseBundle_firebase_in_app_messaging_InAppMessagingDisplayResources_bundle_device.Extension)</LogicalName>
      </BundleResource>
    </ItemGroup>
    <ItemGroup>
      <BundleResource Include="@(_FirebaseBundle_firebase_in_app_messaging_InAppMessagingDisplayResources_bundle_simulator)">
        <LogicalName>InAppMessagingDisplayResources.bundle/%(_FirebaseBundle_firebase_in_app_messaging_InAppMessagingDisplayResources_bundle_simulator.RecursiveDir)%(_FirebaseBundle_firebase_in_app_messaging_InAppMessagingDisplayResources_bundle_simulator.Filename)%(_FirebaseBundle_firebase_in_app_messaging_InAppMessagingDisplayResources_bundle_simulator.Extension)</LogicalName>
      </BundleResource>
    </ItemGroup>
    <ItemGroup>
      <BundleResource Include="@(_FirebaseBundle_firebase_in_app_messaging_InAppMessagingDisplayResources_bundle_catalyst)">
        <LogicalName>InAppMessagingDisplayResources.bundle/%(_FirebaseBundle_firebase_in_app_messaging_InAppMessagingDisplayResources_bundle_catalyst.RecursiveDir)%(_FirebaseBundle_firebase_in_app_messaging_InAppMessagingDisplayResources_bundle_catalyst.Filename)%(_FirebaseBundle_firebase_in_app_messaging_InAppMessagingDisplayResources_bundle_catalyst.Extension)</LogicalName>
      </BundleResource>
    </ItemGroup>
  </Target>
</Project>

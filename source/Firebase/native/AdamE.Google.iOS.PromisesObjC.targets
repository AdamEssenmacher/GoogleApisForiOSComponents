<Project>
  <Import Project="$(MSBuildThisFileDirectory)Firebase.Native.Common.targets" />
  <Target Name="_FirebaseNative_AdamE_Google_iOS_PromisesObjC" BeforeTargets="_BeforeCoreCompileInterfaceDefinitions" DependsOnTargets="_XamarinBuildDownload" Condition="'$(IsBindingProject)' != 'true' And '$(DesignTimeBuild)' != 'true' And '$(IsCrossTargetingBuild)' != 'true' And ('$(TargetPlatformIdentifier)' == 'ios' Or '$(TargetPlatformIdentifier)' == 'maccatalyst') And ('$(OutputType)' != 'Library' Or '$(IsAppExtension)' == 'True')">
    <Error Condition="!Exists('$(_FirebaseNativeRoot)Firebase/FirebaseAnalytics/FBLPromises.xcframework')" Text="Missing Firebase native asset fbl-promises. $(_FirebaseNativeCleanup)" />
    <Error Condition="'$(TargetPlatformIdentifier)' == 'ios' And !$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('iossimulator-')) And !Exists('$(_FirebaseNativeRoot)Firebase/FirebaseAnalytics/FBLPromises.xcframework/ios-arm64/FBLPromises.framework/FBLPromises_Privacy.bundle')" Text="Missing Firebase native asset fbl-promises-FBLPromises_Privacy.bundle-device. $(_FirebaseNativeCleanup)" />
    <Error Condition="'$(TargetPlatformIdentifier)' == 'ios' And $([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('iossimulator-')) And !Exists('$(_FirebaseNativeRoot)Firebase/FirebaseAnalytics/FBLPromises.xcframework/ios-arm64_x86_64-simulator/FBLPromises.framework/FBLPromises_Privacy.bundle')" Text="Missing Firebase native asset fbl-promises-FBLPromises_Privacy.bundle-simulator. $(_FirebaseNativeCleanup)" />
    <Error Condition="'$(TargetPlatformIdentifier)' == 'maccatalyst' And !Exists('$(_FirebaseNativeRoot)Firebase/FirebaseAnalytics/FBLPromises.xcframework/ios-arm64_x86_64-maccatalyst/FBLPromises.framework/Versions/A/Resources/FBLPromises_Privacy.bundle')" Text="Missing Firebase native asset fbl-promises-FBLPromises_Privacy.bundle-catalyst. $(_FirebaseNativeCleanup)" />
    <ItemGroup>
      <NativeReference Include="$(_FirebaseNativeRoot)Firebase/FirebaseAnalytics/FBLPromises.xcframework">
        <Kind>Framework</Kind>
        <SmartLink>True</SmartLink>
        <ForceLoad>True</ForceLoad>
        <IsCxx>True</IsCxx>
        <LinkWithSwiftSystemLibraries>true</LinkWithSwiftSystemLibraries>
        <LinkerFlags>-ObjC -lc++</LinkerFlags>
      </NativeReference>
      <_FirebaseBundle_fbl_promises_FBLPromises_Privacy_bundle_device Include="$(_FirebaseNativeRoot)Firebase/FirebaseAnalytics/FBLPromises.xcframework/ios-arm64/FBLPromises.framework/FBLPromises_Privacy.bundle/**/*" Condition="'$(TargetPlatformIdentifier)' == 'ios' And !$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('iossimulator-'))" />
      <_FirebaseBundle_fbl_promises_FBLPromises_Privacy_bundle_simulator Include="$(_FirebaseNativeRoot)Firebase/FirebaseAnalytics/FBLPromises.xcframework/ios-arm64_x86_64-simulator/FBLPromises.framework/FBLPromises_Privacy.bundle/**/*" Condition="'$(TargetPlatformIdentifier)' == 'ios' And $([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('iossimulator-'))" />
      <_FirebaseBundle_fbl_promises_FBLPromises_Privacy_bundle_catalyst Include="$(_FirebaseNativeRoot)Firebase/FirebaseAnalytics/FBLPromises.xcframework/ios-arm64_x86_64-maccatalyst/FBLPromises.framework/Versions/A/Resources/FBLPromises_Privacy.bundle/**/*" Condition="'$(TargetPlatformIdentifier)' == 'maccatalyst'" />
    </ItemGroup>
    <ItemGroup>
      <BundleResource Include="@(_FirebaseBundle_fbl_promises_FBLPromises_Privacy_bundle_device)">
        <LogicalName>FBLPromises_Privacy.bundle/%(_FirebaseBundle_fbl_promises_FBLPromises_Privacy_bundle_device.RecursiveDir)%(_FirebaseBundle_fbl_promises_FBLPromises_Privacy_bundle_device.Filename)%(_FirebaseBundle_fbl_promises_FBLPromises_Privacy_bundle_device.Extension)</LogicalName>
      </BundleResource>
    </ItemGroup>
    <ItemGroup>
      <BundleResource Include="@(_FirebaseBundle_fbl_promises_FBLPromises_Privacy_bundle_simulator)">
        <LogicalName>FBLPromises_Privacy.bundle/%(_FirebaseBundle_fbl_promises_FBLPromises_Privacy_bundle_simulator.RecursiveDir)%(_FirebaseBundle_fbl_promises_FBLPromises_Privacy_bundle_simulator.Filename)%(_FirebaseBundle_fbl_promises_FBLPromises_Privacy_bundle_simulator.Extension)</LogicalName>
      </BundleResource>
    </ItemGroup>
    <ItemGroup>
      <BundleResource Include="@(_FirebaseBundle_fbl_promises_FBLPromises_Privacy_bundle_catalyst)">
        <LogicalName>FBLPromises_Privacy.bundle/%(_FirebaseBundle_fbl_promises_FBLPromises_Privacy_bundle_catalyst.RecursiveDir)%(_FirebaseBundle_fbl_promises_FBLPromises_Privacy_bundle_catalyst.Filename)%(_FirebaseBundle_fbl_promises_FBLPromises_Privacy_bundle_catalyst.Extension)</LogicalName>
      </BundleResource>
    </ItemGroup>
  </Target>
</Project>
